# Force LF line endings for test fixtures — tree-sitter grammars
# expect Unix line endings and produce wrong parse trees with CRLF.
tests/fixtures/** text eol=lf

# The dashboard page's build output: committed so `cargo build` never needs Node, generated
# by `npm run build` in dashboard/ (CI fails when it differs). Byte-exact, never converted.
dashboard/dist/** -text linguist-generated=true
dashboard/tests/fixtures/json/** text eol=lf
